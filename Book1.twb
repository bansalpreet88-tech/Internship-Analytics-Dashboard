      <column caption='Accident Severity' datatype='integer' name='[Accident_Severity]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Hour' datatype='integer' name='[Calculation_0171581217411072]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [Time])' />
      </column>
      <column caption='Severity Label' datatype='string' name='[Calculation_0171581218205697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Accident_Severity] = 1 THEN &quot;Fatal&quot;&#13;&#10;ELSEIF [Accident_Severity] = 2 THEN &quot;Serious&quot;&#13;&#10;ELSE &quot;Slight&quot;&#13;&#10;END' />
      </column>
      <column caption='Month/Year' datatype='string' name='[Calculation_0171581218299906]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Date]) + &quot; &quot; + STR(YEAR([Date]))' />
      </column>
      <column caption='Urban/Rural Label' datatype='string' name='[Calculation_0171581218869251]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Urban_or_Rural_Area] = 1 THEN &quot;Urban&quot;&#13;&#10;ELSE &quot;Rural&quot;&#13;&#10;END' />
      </column>
      <column caption='Day of week(NAME)' datatype='string' name='[Calculation_0171581219819525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [Date])' />
      </column>
      <column caption='Weather Smart Label' datatype='string' name='[Calculation_0171581248311307]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Weather_Conditions] = 1 THEN &quot;Type 1 (Likely Clear)&quot;&#13;&#10;ELSEIF [Weather_Conditions] = 2 THEN &quot;Type 2 (Likely Rain)&quot;&#13;&#10;ELSEIF [Weather_Conditions] = 3 THEN &quot;Type 3 (Likely Snow)&quot;&#13;&#10;ELSEIF [Weather_Conditions] = 4 THEN &quot;Type 4 (Clear + Wind)&quot;&#13;&#10;ELSEIF [Weather_Conditions] = 5 THEN &quot;Type 5 (Rain + Wind)&quot;&#13;&#10;ELSEIF [Weather_Conditions] = 6 THEN &quot;Type 6 (Snow + Wind)&quot;&#13;&#10;ELSEIF [Weather_Conditions] = 7 THEN &quot;Type 7 (Fog/Mist)&quot;&#13;&#10;ELSEIF [Weather_Conditions] = 8 THEN &quot;Type 8 (Other)&quot;&#13;&#10;ELSE &quot;Type Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Road Type Label' datatype='string' name='[Calculation_0171581249294348]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Road_Type] = 1 THEN &quot;Roundabout&quot;&#13;&#10;ELSEIF [Road_Type] = 2 THEN &quot;One Way Street&quot;&#13;&#10;ELSEIF [Road_Type] = 3 THEN &quot;Dual Carriageway&quot;&#13;&#10;ELSEIF [Road_Type] = 6 THEN &quot;Single Carriageway&quot;&#13;&#10;ELSEIF [Road_Type] = 7 THEN &quot;Slip Road&quot;&#13;&#10;ELSE &quot;Other/Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Valid Location' datatype='boolean' name='[Calculation_0171581255278606]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[latitude] &gt;= 10 AND [latitude] &lt;= 35&#13;&#10;AND&#13;&#10;[longitude] &gt;= 70 AND [longitude] &lt;= 90' />
      </column>
      <column caption='Fatal_Count' datatype='integer' name='[Calculation_0171581277605904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0171581218205697] = &quot;Fatal&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Severity_Rate' datatype='real' default-format='p0.0%' name='[Calculation_0171581278695441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0171581277605904]) / count([Accident_Index])' />
      </column>
